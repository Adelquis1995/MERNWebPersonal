# Copia este archivo como .env y completa los valores reales.
# El .env NUNCA se sube al repositorio.

# ─── Base de datos (MongoDB Atlas) ───────────────────────────
DB_USER=
DB_PASSWORD=
DB_HOST=

# ─── Servidor ────────────────────────────────────────────────
PORT=3977
IP_SERVER=localhost
API_VERSION=v1

# ─── Seguridad ───────────────────────────────────────────────
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET_KEY=
